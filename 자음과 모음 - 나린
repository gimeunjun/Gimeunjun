<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>한글 모험 놀이터</title>
  <link href="https://cdn.jsdelivr.net/gh/webfontworld/baemin/BMJUA.css" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-user-select: none; user-select: none; }
    html, body {
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background: #10121a;
      color: #fff;
      font-family: 'BM JUA', sans-serif;
    }

    #intro, #menu, #gameScreen {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 4vh 5vw;
      text-align: center;
    }

    #intro {
      z-index: 3;
      background: linear-gradient(135deg, #ffd54f, #ff9800);
      color: #2d2208;
      transition: opacity 0.8s ease;
    }

    #intro h1 { font-size: min(12vw, 76px); line-height: 1.2; }
    #intro p { margin-top: 2vh; font-size: min(4.4vw, 28px); }

    #menu {
      z-index: 2;
      display: none;
      gap: 2vh;
      background: radial-gradient(circle at top, #29324c 0%, #141826 60%, #0d1018 100%);
    }

    .title { font-size: min(9vw, 54px); color: #ffec7d; text-shadow: 0 3px 0 rgba(0,0,0,0.35); }
    .subtitle { font-size: min(4.5vw, 26px); color: #d5deff; margin-bottom: 2vh; }

    .menu-grid {
      display: grid;
      width: min(92vw, 560px);
      grid-template-columns: 1fr;
      gap: 1.5vh;
    }

    .menu-btn {
      border: none;
      border-radius: 16px;
      padding: 2.1vh 2vw;
      font-size: min(7vw, 40px);
      color: #10203f;
      background: #ffeb3b;
      box-shadow: 0 8px 0 #c3b429;
      cursor: pointer;
    }

    .menu-btn:active { transform: translateY(3px); box-shadow: 0 5px 0 #c3b429; }

    #gameScreen {
      display: none;
      justify-content: flex-start;
      background: #090d17;
      z-index: 1;
    }

    .top-bar {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 1vh;
      align-items: center;
      padding-top: 1.5vh;
      z-index: 3;
    }

    .status {
      text-align: left;
      font-size: min(4.2vw, 24px);
      color: #cfd8ff;
    }

    #score {
      font-size: min(4.7vw, 28px);
      color: #ffeb3b;
    }

    #guideBox {
      margin-top: 2vh;
      width: 100%;
      text-align: center;
      z-index: 3;
    }

    #modeLabel {
      font-size: min(4.5vw, 26px);
      color: #8dd7ff;
    }

    #target {
      margin-top: 0.5vh;
      font-size: min(19vw, 150px);
      line-height: 1;
      color: #ffffff;
      text-shadow: 0 6px 18px rgba(0,0,0,0.35);
    }

    #hint {
      margin-top: 1vh;
      font-size: min(4.4vw, 26px);
      color: #ffd8b3;
      min-height: 1.5em;
    }

    #feedback {
      margin-top: 0.6vh;
      font-size: min(5vw, 30px);
      color: #ffec7d;
      min-height: 1.5em;
    }

    #drawCanvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      touch-action: none;
      z-index: 1;
    }

    #confettiCanvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 5;
      pointer-events: none;
    }

    .controls {
      position: absolute;
      bottom: 3vh;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 2vw;
      z-index: 4;
    }

    .ctrl-btn {
      border: none;
      border-radius: 14px;
      font-size: min(7vw, 42px);
      padding: 1.6vh 3.8vw;
      background: #1f2a44;
      color: #fff;
      box-shadow: 0 6px 0 #141b2b;
      cursor: pointer;
    }

    .ctrl-btn.primary { background: #00c853; box-shadow: 0 6px 0 #06853c; }

    #resultModal {
      display: none;
      position: absolute;
      inset: 0;
      z-index: 10;
      background: rgba(9, 12, 20, 0.78);
      align-items: center;
      justify-content: center;
      padding: 4vh 4vw;
    }

    #resultCard {
      width: min(90vw, 540px);
      background: #1b2339;
      border-radius: 18px;
      padding: 3vh 5vw;
      box-shadow: 0 16px 40px rgba(0,0,0,0.4);
    }

    #resultCard h2 { font-size: min(9vw, 50px); color: #ffef7a; }
    #resultText { margin-top: 1vh; font-size: min(5vw, 30px); color: #ffffff; }
    #resultCard .menu-btn { margin-top: 2vh; width: 100%; font-size: min(6vw, 36px); }
  </style>
</head>
<body>
  <div id="intro">
    <h1>한글 모험 놀이터</h1>
    <p>자음 · 모음 · 받침을 게임처럼 배워요! 👧🏻👦🏻</p>
  </div>

  <div id="menu">
    <div class="title">오늘의 한글 게임</div>
    <div class="subtitle">배우고 싶은 모드를 눌러보자!</div>
    <div class="menu-grid">
      <button class="menu-btn" data-mode="consonant">🧩 자음 따라 쓰기</button>
      <button class="menu-btn" data-mode="vowel">🌈 모음 따라 쓰기</button>
      <button class="menu-btn" data-mode="batchim">🚀 받침 소리 맞히기</button>
      <button class="menu-btn" data-mode="mixed">🎯 자음+모음+받침 랜덤</button>
    </div>
  </div>

  <div id="gameScreen">
    <canvas id="drawCanvas"></canvas>
    <canvas id="confettiCanvas"></canvas>

    <div class="top-bar">
      <div class="status" id="progress">1 / 1</div>
      <div id="score">⭐ 점수 0</div>
    </div>

    <div id="guideBox">
      <div id="modeLabel">학습 모드</div>
      <div id="target">ㄱ</div>
      <div id="hint"></div>
      <div id="feedback"></div>
    </div>

    <div class="controls">
      <button class="ctrl-btn" id="menuBtn">🏠</button>
      <button class="ctrl-btn" id="clearBtn">🧹</button>
      <button class="ctrl-btn primary" id="checkBtn">✅</button>
    </div>
  </div>

  <div id="resultModal">
    <div id="resultCard">
      <h2>완료했어!</h2>
      <div id="resultText"></div>
      <button class="menu-btn" id="playAgainBtn">다시 도전</button>
      <button class="menu-btn" id="toMenuBtn">메뉴로 가기</button>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
  <script>
    const consonants = ['ㄱ','ㄴ','ㄷ','ㄹ','ㅁ','ㅂ','ㅅ','ㅇ','ㅈ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];
    const vowels = ['ㅏ','ㅑ','ㅓ','ㅕ','ㅗ','ㅛ','ㅜ','ㅠ','ㅡ','ㅣ'];
    const batchimWords = [
      { syllable: '각', batchim: 'ㄱ', word: '각', hint: '🦌 사슴의 뿔은 뾰족해요. "각"의 받침은?' },
      { syllable: '눈', batchim: 'ㄴ', word: '눈', hint: '❄️ 하늘에서 내리는 "눈"의 받침은?' },
      { syllable: '꽃', batchim: 'ㅊ', word: '꽃', hint: '🌸 예쁜 "꽃"의 마지막 소리는?' },
      { syllable: '집', batchim: 'ㅂ', word: '집', hint: '🏠 우리가 사는 "집"의 받침은?' },
      { syllable: '달', batchim: 'ㄹ', word: '달', hint: '🌙 밤하늘의 "달" 받침은?' },
      { syllable: '밥', batchim: 'ㅂ', word: '밥', hint: '🍚 맛있는 "밥"의 받침은?' }
    ];

    const modeConfig = {
      consonant: { label: '자음 따라 쓰기', type: 'trace' },
      vowel: { label: '모음 따라 쓰기', type: 'trace' },
      batchim: { label: '받침 소리 맞히기', type: 'batchim' },
      mixed: { label: '랜덤 종합 학습', type: 'mixed' }
    };

    const introEl = document.getElementById('intro');
    const menuEl = document.getElementById('menu');
    const gameScreen = document.getElementById('gameScreen');
    const progressEl = document.getElementById('progress');
    const scoreEl = document.getElementById('score');
    const modeLabelEl = document.getElementById('modeLabel');
    const targetEl = document.getElementById('target');
    const hintEl = document.getElementById('hint');
    const feedbackEl = document.getElementById('feedback');
    const resultModal = document.getElementById('resultModal');
    const resultText = document.getElementById('resultText');

    const canvas = document.getElementById('drawCanvas');
    const ctx = canvas.getContext('2d');
    const confettiCanvas = document.getElementById('confettiCanvas');

    let firstInteraction = false;
    let drawing = false;
    let score = 0;
    let currentIndex = 0;
    let currentMode = 'consonant';
    let rounds = [];

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      confettiCanvas.width = window.innerWidth;
      confettiCanvas.height = window.innerHeight;
      setupPen();
    }

    function setupPen() {
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = Math.max(14, window.innerWidth * 0.04);
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
    }

    function speak(text) {
      if (!firstInteraction || !('speechSynthesis' in window)) return;
      const utter = new SpeechSynthesisUtterance(text);
      utter.lang = 'ko-KR';
      speechSynthesis.cancel();
      speechSynthesis.speak(utter);
    }

    function clearCanvas() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }

    function showMenu() {
      gameScreen.style.display = 'none';
      resultModal.style.display = 'none';
      menuEl.style.display = 'flex';
    }

    function buildRounds(mode) {
      if (mode === 'consonant') return consonants.map(char => ({ kind: 'trace', target: char }));
      if (mode === 'vowel') return vowels.map(char => ({ kind: 'trace', target: char }));
      if (mode === 'batchim') return batchimWords.map(item => ({ kind: 'batchim', ...item }));

      const mixedSet = [
        ...consonants.slice(0, 6).map(char => ({ kind: 'trace', target: char })),
        ...vowels.slice(0, 5).map(char => ({ kind: 'trace', target: char })),
        ...batchimWords.slice(0, 4).map(item => ({ kind: 'batchim', ...item }))
      ];
      return mixedSet.sort(() => Math.random() - 0.5);
    }

    function startGame(mode) {
      currentMode = mode;
      rounds = buildRounds(mode);
      currentIndex = 0;
      score = 0;
      resultModal.style.display = 'none';
      menuEl.style.display = 'none';
      gameScreen.style.display = 'flex';
      updateRound();
      clearCanvas();
    }

    function updateRound() {
      const round = rounds[currentIndex];
      progressEl.textContent = `${currentIndex + 1} / ${rounds.length}`;
      scoreEl.textContent = `⭐ 점수 ${score}`;
      modeLabelEl.textContent = modeConfig[currentMode].label;
      feedbackEl.textContent = '';
      clearCanvas();

      if (round.kind === 'trace') {
        targetEl.textContent = round.target;
        hintEl.textContent = '점선을 따라 크게 써보고, 확인 버튼을 눌러요!';
        targetEl.style.opacity = '0.25';
        speak(round.target);
      } else {
        targetEl.textContent = round.syllable;
        hintEl.textContent = round.hint;
        targetEl.style.opacity = '1';
        speak(`${round.word} 받침 맞히기`);
      }
    }

    function traceAccuracy(char) {
      const tempCanvas = document.createElement('canvas');
      tempCanvas.width = canvas.width;
      tempCanvas.height = canvas.height;
      const tCtx = tempCanvas.getContext('2d');
      tCtx.font = `${Math.min(canvas.width * 0.56, canvas.height * 0.5)}px 'BM JUA'`;
      tCtx.fillStyle = '#ffffff';
      tCtx.textAlign = 'center';
      tCtx.textBaseline = 'middle';
      tCtx.fillText(char, canvas.width / 2, canvas.height / 2);

      const userData = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
      const refData = tCtx.getImageData(0, 0, canvas.width, canvas.height).data;
      let match = 0;
      let total = 0;

      for (let i = 0; i < refData.length; i += 4) {
        if (refData[i + 3] > 10) {
          total += 1;
          if (userData[i + 3] > 10) match += 1;
        }
      }
      return total ? (match / total) * 100 : 0;
    }

    function nextRound() {
      if (currentIndex >= rounds.length - 1) {
        finishGame();
        return;
      }
      currentIndex += 1;
      updateRound();
    }

    function celebrate() {
      confetti.create(confettiCanvas)({
        particleCount: 90,
        spread: 74,
        startVelocity: 48,
        decay: 0.93,
        ticks: 110
      });
    }

    function checkAnswer() {
      const round = rounds[currentIndex];

      if (round.kind === 'trace') {
        const accuracy = traceAccuracy(round.target);
        if (accuracy >= 33) {
          const gained = accuracy >= 70 ? 10 : 6;
          score += gained;
          feedbackEl.textContent = `멋져! +${gained}점 (${Math.round(accuracy)}점 정확도)`;
          celebrate();
          setTimeout(nextRound, 1200);
        } else {
          feedbackEl.textContent = `조금만 더! (${Math.round(accuracy)}점)`;
          speak('한 번 더 써볼까?');
        }
        scoreEl.textContent = `⭐ 점수 ${score}`;
        return;
      }

      const answer = prompt(`"${round.word}"의 받침은 무엇일까? (예: ㄱ)`);
      if (!answer) {
        feedbackEl.textContent = '입력하지 않았어. 다시 눌러볼까?';
        return;
      }

      const cleaned = answer.trim();
      if (cleaned === round.batchim) {
        score += 12;
        scoreEl.textContent = `⭐ 점수 ${score}`;
        feedbackEl.textContent = `정답! ${round.syllable}의 받침은 ${round.batchim}`;
        celebrate();
        speak('정답이야');
        setTimeout(nextRound, 1200);
      } else {
        feedbackEl.textContent = `아쉬워! 정답은 ${round.batchim}이야.`;
        speak(`정답은 ${round.batchim}`);
      }
    }

    function finishGame() {
      resultText.textContent = `총 ${rounds.length}문제를 끝냈고, ${score}점을 받았어! 정말 잘했어!`;
      resultModal.style.display = 'flex';
      celebrate();
      celebrate();
      speak('게임 완료! 최고야!');
    }

    function pointerPos(event) {
      if (event.touches && event.touches.length) {
        return { x: event.touches[0].clientX, y: event.touches[0].clientY };
      }
      return { x: event.clientX, y: event.clientY };
    }

    function beginDraw(event) {
      const round = rounds[currentIndex];
      if (!round || round.kind !== 'trace') return;
      event.preventDefault();
      const p = pointerPos(event);
      drawing = true;
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
    }

    function moveDraw(event) {
      if (!drawing) return;
      event.preventDefault();
      const p = pointerPos(event);
      ctx.lineTo(p.x, p.y);
      ctx.stroke();
    }

    function stopDraw() {
      drawing = false;
    }

    document.querySelectorAll('.menu-btn[data-mode]').forEach((btn) => {
      btn.addEventListener('click', () => startGame(btn.dataset.mode));
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      clearCanvas();
      feedbackEl.textContent = '';
    });

    document.getElementById('checkBtn').addEventListener('click', checkAnswer);
    document.getElementById('menuBtn').addEventListener('click', showMenu);
    document.getElementById('playAgainBtn').addEventListener('click', () => startGame(currentMode));
    document.getElementById('toMenuBtn').addEventListener('click', showMenu);

    ['mousedown', 'touchstart'].forEach((evt) => canvas.addEventListener(evt, beginDraw, { passive: false }));
    ['mousemove', 'touchmove'].forEach((evt) => canvas.addEventListener(evt, moveDraw, { passive: false }));
    ['mouseup', 'mouseleave', 'touchend', 'touchcancel'].forEach((evt) => canvas.addEventListener(evt, stopDraw));

    ['click', 'touchstart', 'keydown'].forEach(evt => {
      window.addEventListener(evt, () => { firstInteraction = true; }, { once: true });
    });

    window.addEventListener('resize', resizeCanvas);

    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        introEl.style.opacity = '0';
        setTimeout(() => {
          introEl.style.display = 'none';
          menuEl.style.display = 'flex';
        }, 850);
      }, 1400);

      resizeCanvas();
    });
  </script>
</body>
</html>
